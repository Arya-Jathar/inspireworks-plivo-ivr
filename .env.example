# Copy to .env and fill in locally. Never commit .env.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=+91YOUR_PLIVO_NUMBER

# Your own phone in E.164 format, e.g. +919876543210. This is an allowlist:
# the demo will refuse to call any other destination.
ALLOWED_DESTINATION_NUMBER=

# Choose a private PIN for the Call Me page. Do not share it publicly.
CALL_TRIGGER_PIN=

# Public HTTPS base URL reachable by Plivo (e.g. your ngrok URL); not localhost.
PLIVO_PUBLIC_BASE_URL=

# Your birthdate in DDMM format as a four-character string; used for OTP authentication.
OTP_CODE=

# Associate number supplied in the assignment, converted to international E.164 format.
ASSOCIATE_NUMBER=+912264236412

# Optional public HTTPS MP3s for Level 2. If blank, a Plivo-hosted public sample clip is used.
AUDIO_EN_URL=
AUDIO_ES_URL=
